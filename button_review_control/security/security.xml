<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Privilege under Accounting category -->
    <record model="res.groups.privilege" id="privilege_maker_checker">
        <field name="name">Maker &amp; Checker</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">60</field>
    </record>

    <!-- Maker: cannot see action buttons, can request review -->
    <record id="group_maker" model="res.groups">
        <field name="name">Maker</field>
        <field name="sequence">10</field>
        <field name="comment">Hides Post, Confirm, Pay, Reset, Cancel and Delete buttons. Can request review.</field>
        <field name="privilege_id" ref="privilege_maker_checker"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Checker: sees all buttons normally -->
    <record id="group_checker" model="res.groups">
        <field name="name">Checker</field>
        <field name="sequence">20</field>
        <field name="comment">Receives review requests from Makers. Has full access to action buttons.</field>
        <field name="privilege_id" ref="privilege_maker_checker"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

</odoo>
