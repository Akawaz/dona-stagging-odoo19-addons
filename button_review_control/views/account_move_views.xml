    <record id="view_invoice_tree_inherit_review_control" model="ir.ui.view">
        <field name="name">account.invoice.list.inherit.review.control</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
