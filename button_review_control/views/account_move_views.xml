    <!-- ====== Payment list view ====== -->
    <record id="view_account_payment_tree_inherit_review_control" model="ir.ui.view">
        <field name="name">account.payment.list.inherit.review.control</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="review_state" widget="badge"
                       decoration-success="review_state == 'reviewed'"
                       decoration-warning="review_state == 'to_review'"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ====== Payment kanban view ====== -->
    <record id="view_account_payment_kanban_inherit_review_control" model="ir.ui.view">
        <field name="name">account.payment.kanban.inherit.review.control</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="review_state" widget="badge"
