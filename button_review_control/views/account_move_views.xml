                       invisible="review_state != 'to_review'"
                       class="ms-auto"/>
            </xpath>
        </field>
    </record>

    <!-- ====== Search views: filters and group-by for review_state ====== -->

    <!-- Journal Entry search -->
    <record id="view_account_move_filter_inherit_review_control" model="ir.ui.view">
        <field name="name">account.move.search.inherit.review.control</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='unposted']" position="before">
                <separator/>
                <filter string="Waiting for Review" name="review_to_review"
                        domain="[('review_state', '=', 'to_review')]"/>
                <filter string="Reviewed" name="review_reviewed"
                        domain="[('review_state', '=', 'reviewed')]"/>
            </xpath>
            <xpath expr="//group/filter[@name='status']" position="after">
                <filter string="Review Status" name="group_by_review_state"
                        domain="[]" context="{'group_by': 'review_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- Invoice/Bill search -->
    <record id="view_account_invoice_filter_inherit_review_control" model="ir.ui.view">
        <field name="name">account.invoice.search.inherit.review.control</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft']" position="before">
                <separator/>
                <filter string="Waiting for Review" name="review_to_review"
                        domain="[('review_state', '=', 'to_review')]"/>
                <filter string="Reviewed" name="review_reviewed"
                        domain="[('review_state', '=', 'reviewed')]"/>
            </xpath>
            <xpath expr="//group/filter[@name='status']" position="after">
                <filter string="Review Status" name="group_by_review_state"
                        domain="[]" context="{'group_by': 'review_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- Payment search -->
    <record id="view_account_payment_search_inherit_review_control" model="ir.ui.view">
        <field name="name">account.payment.search.inherit.review.control</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='state_draft']" position="before">
                <separator/>
                <filter string="Waiting for Review" name="review_to_review"
                        domain="[('review_state', '=', 'to_review')]"/>
                <filter string="Reviewed" name="review_reviewed"
                        domain="[('review_state', '=', 'reviewed')]"/>
            </xpath>
            <xpath expr="//filter[@name='state']" position="after">
                <filter string="Review Status" name="group_by_review_state"
                        domain="[]" context="{'group_by': 'review_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- ====== Server actions: Mark as Reviewed (checker group only) ====== -->

    <record id="action_mark_move_reviewed" model="ir.actions.server">
        <field name="name">Mark as Reviewed</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('button_review_control.group_checker'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_mark_reviewed()</field>
    </record>

    <record id="action_mark_payment_reviewed" model="ir.actions.server">
        <field name="name">Mark as Reviewed</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('button_review_control.group_checker'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_mark_reviewed()</field>
    </record>

</odoo>
