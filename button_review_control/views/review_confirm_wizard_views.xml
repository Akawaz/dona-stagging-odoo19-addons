<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_review_confirm_wizard" model="ir.ui.view">
        <field name="name">review.confirm.wizard.form</field>
        <field name="model">review.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Review">
                <sheet>
                    <group>
                        <div class="alert alert-warning" role="alert">
                            <p><strong>You are the creator of this entry.</strong></p>
                            <p>Are you sure you want to confirm and post this entry yourself?</p>
                        </div>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object"
                                string="Confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
