<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_dona_branch" model="ir.ui.view">
        <field name="name">sale.order.form.dona.branch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button type="object" name="action_view_pos_order"
                        class="oe_stat_button" icon="fa-shopping-cart"
                        invisible="not pos_order_id">
                    <field name="pos_routing_state" widget="statinfo" string="POS Order"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Branch &amp; Delivery" name="dona_branch"
                      invisible="not website_id and not branch_id">
                    <group>
                        <group string="Branch / POS Routing">
                            <field name="branch_id"/>
                            <field name="pos_config_id"/>
                            <field name="order_type"/>
                            <field name="pos_order_id"/>
                            <field name="pos_routing_state" widget="badge"
                                   decoration-success="pos_routing_state == 'sent'"
                                   decoration-warning="pos_routing_state in ('pending', 'queued')"
                                   decoration-danger="pos_routing_state in ('failed', 'cancelled')"/>
                            <field name="pos_routing_error" invisible="not pos_routing_error"/>
                        </group>
                        <group string="Requested Schedule">
                            <field name="scheduled_date"/>
                            <field name="scheduled_time"/>
                            <field name="scheduled_datetime"/>
                            <field name="branch_address"/>
                            <field name="branch_phone"/>
                        </group>
                    </group>
                    <group string="Order Notes">
                        <field name="customer_note" nolabel="1"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_order_list_dona_branch" model="ir.ui.view">
        <field name="name">sale.order.list.dona.branch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="branch_id" optional="hide"/>
                <field name="pos_routing_state" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
