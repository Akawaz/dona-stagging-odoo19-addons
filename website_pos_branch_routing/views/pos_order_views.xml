<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_pos_form_dona_branch" model="ir.ui.view">
        <field name="name">pos.order.form.dona.branch</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object" name="action_view_website_sale_order"
                        class="oe_stat_button" icon="fa-globe"
                        invisible="not website_sale_order_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Website Order</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
