<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_purchase_request">
        <field name="name">Purchase Request</field>
        <field name="sequence">9</field>
        <field name="category_id" ref="base.module_category_purchases"/>
    </record>

    <record id="group_purchase_request_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_purchase_request_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_user'))]"/>
    </record>

    <record id="group_purchase_request_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_approver'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
