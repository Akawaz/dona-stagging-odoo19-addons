<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_request_line_tree" model="ir.ui.view">
        <field name="name">purchase.request.line.tree</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <list string="Order Request Lines" editable="bottom">
                <field name="request_id" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <field name="description" readonly="1"/>
                <field name="required_qty" readonly="1"/>
                <field name="available_qty" readonly="1"/>
                <field name="uom_id" readonly="1" groups="uom.group_uom"/>
                <field name="vendor_id" readonly="1"/>
                <field name="purchase_order_id" readonly="1"/>
                <field name="state" readonly="1" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_request_line_search" model="ir.ui.view">
        <field name="name">purchase.request.line.search</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <search string="Order Request Lines">
                <field name="request_id"/>
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="product_category_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="pending_po" string="Pending PO Creation" domain="[('purchase_order_line_id', '=', False)]"/>
                <group>
                    <filter name="groupby_request" string="Order Request" domain="[]" context="{'group_by': 'request_id'}"/>
                    <filter name="groupby_product" string="Product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter name="groupby_vendor" string="Vendor" domain="[]" context="{'group_by': 'vendor_id'}"/>
                    <filter name="groupby_category" string="Product Category" domain="[]" context="{'group_by': 'product_category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_request_line" model="ir.actions.act_window">
        <field name="name">Request Lines</field>
        <field name="res_model">purchase.request.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_request_line_search"/>
    </record>
</odoo>
