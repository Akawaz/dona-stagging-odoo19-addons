<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_request_approval_hierarchy_tree" model="ir.ui.view">
        <field name="name">purchase.request.approval.hierarchy.tree</field>
        <field name="model">purchase.request.approval.hierarchy</field>
        <field name="arch" type="xml">
            <list string="Approval Hierarchy" create="false" delete="false">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_request_approval_hierarchy_form" model="ir.ui.view">
        <field name="name">purchase.request.approval.hierarchy.form</field>
        <field name="model">purchase.request.approval.hierarchy</field>
        <field name="arch" type="xml">
            <form string="Approval Hierarchy">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Approval Flow Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approvers" name="approvers">
                            <field name="delegated_ids" context="{'default_hierarchy_id': id}">
                                <list editable="bottom">
                                    <field name="level"/>
                                    <field name="name"/>
                                    <field name="user_id" options="{'no_create': True}"/>
                                    <field name="group_id" options="{'no_create': True}"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_request_approval_hierarchy" model="ir.actions.act_window">
        <field name="name">Approval Hierarchy</field>
        <field name="res_model">purchase.request.approval.hierarchy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
