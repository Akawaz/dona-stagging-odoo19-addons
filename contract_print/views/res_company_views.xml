<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_contract_print" model="ir.ui.view">
        <field name="name">res.company.form.contract.print</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">

                <group string="Contract Settings">

                    <group>
                        <field name="contract_representative"/>
                        <field name="contract_cr_number"/>
                        <field name="contract_address"/>
                    </group>

                    <group>
                        <field name="contract_header_image"
                               widget="image"
                               class="oe_avatar"/>

                        <field name="contract_footer_image"
                               widget="image"
                               class="oe_avatar"/>
                    </group>

                </group>

            </xpath>

        </field>
    </record>

</odoo>