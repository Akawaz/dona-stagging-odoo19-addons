<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Tree View -->
    <!-- ===================================================== -->

    <record id="view_kitchen_shift_tree" model="ir.ui.view">
        <field name="name">kitchen.shift.tree</field>
        <field name="model">kitchen.shift</field>
        <field name="arch" type="xml">

            <list>

                <field name="sequence" widget="handle"/>

                <field name="name"/>

                <field name="code"/>

                <field name="start_time" widget="float_time"/>

                <field name="end_time" widget="float_time"/>

                <field name="company_id"/>

                <field name="active"/>

            </list>

        </field>
    </record>

    <!-- ===================================================== -->
    <!-- Form View -->
    <!-- ===================================================== -->

    <record id="view_kitchen_shift_form" model="ir.ui.view">
        <field name="name">kitchen.shift.form</field>
        <field name="model">kitchen.shift</field>
        <field name="arch" type="xml">

            <form string="Kitchen Shift">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>

                            <field name="code"/>

                            <field name="sequence"/>

                            <field name="company_id"/>

                            <field name="active"/>

                        </group>

                        <group>

                            <field
                                name="start_time"
                                widget="float_time"/>

                            <field
                                name="end_time"
                                widget="float_time"/>

                            <field
                                name="preparation_start"
                                widget="float_time"/>

                            <field
                                name="preparation_end"
                                widget="float_time"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Notes">

                            <field
                                name="notes"
                                placeholder="Kitchen preparation instructions for this shift..."/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

    <!-- ===================================================== -->
    <!-- Action -->
    <!-- ===================================================== -->

    <record id="action_kitchen_shift" model="ir.actions.act_window">
        <field name="name">Kitchen Shifts</field>
        <field name="res_model">kitchen.shift</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
