<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View -->

    <record id="view_kitchen_prepare_template_tree" model="ir.ui.view">
        <field name="name">kitchen.prepare.template.tree</field>
        <field name="model">kitchen.prepare.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->

    <record id="view_kitchen_prepare_template_form" model="ir.ui.view">
        <field name="name">kitchen.prepare.template.form</field>
        <field name="model">kitchen.prepare.template</field>
        <field name="arch" type="xml">
            <form string="Preparation Template">

                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>

                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Products">

                            <field name="line_ids">

                                <list editable="bottom">

                                    <field name="sequence" widget="handle"/>

                                    <field name="product_id"/>

                                    <field name="par_level_qty"/>

                                    <field name="uom_id" readonly="1"/>

                                    <field name="note"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- Action -->

    <record id="action_kitchen_prepare_template" model="ir.actions.act_window">
        <field name="name">Preparation Templates</field>
        <field name="res_model">kitchen.prepare.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>