<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dahua_device_form" model="ir.ui.view">
        <field name="name">dahua.device.form</field>
        <field name="model">dahua.device</field>
        <field name="arch" type="xml">
            <form string="Dahua Device">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-secondary"/>
                    <button name="action_open_sync_wizard" type="object"
                            string="Sync Now" class="btn-primary"/>
                    <button name="action_enroll_employees" type="object"
                            string="Enroll Employees" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="record_count" widget="statinfo" string="Records"/>
                        </button>
                        <button name="action_view_logs" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="sync_log_count" widget="statinfo" string="Sync Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Main Gate - ASI2212H-DW"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="connection_mode"/>
                            <field name="ip_address" placeholder="192.168.1.108"/>
                            <field name="port"/>
                            <field name="use_ssl"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                        </group>
                        <group string="Identification &amp; Sync">
                            <field name="serial_number"/>
                            <field name="verify_serial"/>
                            <field name="device_type" readonly="1"/>
                            <field name="software_version" readonly="1"/>
                            <field name="active"/>
                            <field name="auto_sync"/>
                            <field name="unmapped_employee_action"/>
                            <field name="debug_mode"/>
                        </group>
                    </group>
                    <group string="Status">
                        <group>
                            <field name="last_sync_time" readonly="1"/>
                            <field name="last_sync_epoch" readonly="1" groups="base.group_no_one"/>
                        </group>
                        <group>
                            <field name="last_error" readonly="1" invisible="not last_error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dahua_device_list" model="ir.ui.view">
        <field name="name">dahua.device.list</field>
        <field name="model">dahua.device</field>
        <field name="arch" type="xml">
            <list string="Dahua Devices">
                <field name="name"/>
                <field name="ip_address"/>
                <field name="port"/>
                <field name="connection_mode"/>
                <field name="serial_number"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"/>
                <field name="last_sync_time"/>
                <field name="auto_sync"/>
            </list>
        </field>
    </record>

    <record id="action_dahua_device" model="ir.actions.act_window">
        <field name="name">Dahua Devices</field>
        <field name="res_model">dahua.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a Dahua device
            </p>
            <p>
                Enter the device IP and port (37777 for the SmartPSS-style private
                protocol), the login credentials and optionally the serial number,
                then use "Test Connection" and "Sync Now".
            </p>
        </field>
    </record>

</odoo>
