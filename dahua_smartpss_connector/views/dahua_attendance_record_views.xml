<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dahua_record_list" model="ir.ui.view">
        <field name="name">dahua.attendance.record.list</field>
        <field name="model">dahua.attendance.record</field>
        <field name="arch" type="xml">
            <list string="Fetched Records">
                <field name="punch_time"/>
                <field name="device_id"/>
                <field name="device_user_id"/>
                <field name="card_name"/>
                <field name="employee_id"/>
                <field name="attendance_id"/>
            </list>
        </field>
    </record>

    <record id="view_dahua_record_form" model="ir.ui.view">
        <field name="name">dahua.attendance.record.form</field>
        <field name="model">dahua.attendance.record</field>
        <field name="arch" type="xml">
            <form string="Fetched Record">
                <sheet>
                    <group>
                        <group>
                            <field name="device_id"/>
                            <field name="rec_no"/>
                            <field name="device_user_id"/>
                            <field name="card_name"/>
                        </group>
                        <group>
                            <field name="punch_time"/>
                            <field name="employee_id"/>
                            <field name="attendance_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dahua_record" model="ir.actions.act_window">
        <field name="name">Fetched Records</field>
        <field name="res_model">dahua.attendance.record</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
