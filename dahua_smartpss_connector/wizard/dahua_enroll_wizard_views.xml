<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dahua_enroll_wizard_form" model="ir.ui.view">
        <field name="name">dahua.enroll.wizard.form</field>
        <field name="model">dahua.enroll.wizard</field>
        <field name="arch" type="xml">
            <form string="Enroll Employees on Dahua Device">
                <group>
                    <field name="device_id"/>
                    <field name="mode" widget="radio"/>
                </group>
                <group invisible="mode != 'existing'">
                    <field name="employee_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <group invisible="mode != 'new'" string="New Employee">
                    <field name="new_name" required="mode == 'new'"/>
                    <field name="new_person_id" required="mode == 'new'"/>
                    <field name="new_card_no"/>
                </group>
                <group invisible="not result_summary" string="Result">
                    <field name="result_summary" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_enroll" type="object" string="Push to Device"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dahua_enroll_wizard" model="ir.actions.act_window">
        <field name="name">Enroll Employees</field>
        <field name="res_model">dahua.enroll.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
