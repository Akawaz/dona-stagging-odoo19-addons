<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dahua_sync_wizard_form" model="ir.ui.view">
        <field name="name">dahua.sync.wizard.form</field>
        <field name="model">dahua.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Attendance">
                <group>
                    <field name="device_id"/>
                    <field name="mode" widget="radio"/>
                    <field name="from_date" invisible="mode != 'from_date'"
                           required="mode == 'from_date'"/>
                </group>
                <footer>
                    <button name="action_sync" type="object" string="Sync"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dahua_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync Attendance</field>
        <field name="res_model">dahua.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
