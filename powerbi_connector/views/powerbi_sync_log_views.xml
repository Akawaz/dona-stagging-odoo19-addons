<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerbi_sync_log_list" model="ir.ui.view">
        <field name="name">powerbi.sync.log.list</field>
        <field name="model">powerbi.sync.log</field>
        <field name="arch" type="xml">
            <list string="Power BI Sync Logs">
                <field name="name"/>
                <field name="config_id"/>
                <field name="sync_type"/>
                <field name="data_type"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration" widget="float_time"/>
                <field name="records_processed"/>
                <field name="records_created"/>
                <field name="records_failed"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-info="status == 'running'"
                       decoration-warning="status == 'partial'"
                       decoration-danger="status == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_powerbi_sync_log_form" model="ir.ui.view">
        <field name="name">powerbi.sync.log.form</field>
        <field name="model">powerbi.sync.log</field>
        <field name="arch" type="xml">
            <form string="Power BI Sync Log">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="config_id"/>
                            <field name="sync_type"/>
                            <field name="data_type"/>
                            <field name="status" widget="badge"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration"/>
                            <field name="records_processed"/>
                            <field name="records_created"/>
                            <field name="records_failed"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="not error_message" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_powerbi_sync_log_search" model="ir.ui.view">
        <field name="name">powerbi.sync.log.search</field>
        <field name="model">powerbi.sync.log</field>
        <field name="arch" type="xml">
            <search string="Search Sync Logs">
                <field name="config_id"/>
                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter string="Manual" name="manual" domain="[('sync_type', '=', 'manual')]"/>
                <filter string="Automatic" name="automatic" domain="[('sync_type', '=', 'automatic')]"/>
                <group>
                    <filter string="Connection" name="group_config" context="{'group_by': 'config_id'}"/>
                    <filter string="Data Type" name="group_data_type" context="{'group_by': 'data_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_powerbi_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">powerbi.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
