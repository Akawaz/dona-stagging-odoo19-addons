<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_non_bahraini_contract_document">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="employee">

        <!-- Fixed Header -->
        <div class="header">
          <table class="header-table">
            <tr>
              <td class="header-left">
                <t t-if="employee.company_id.contract_header_image">
                  <img t-att-src="'/web/image/%s/%s/contract_header_image' % ('res.company', employee.company_id.id)" style="height: 60px;"/>
                </t>
                <t t-else="">
                  <div class="logo-placeholder">LOGO</div>
                </t>
              </td>
              <td class="header-right">
                <div class="company-info">
                  <span class="company-name" t-esc="employee.company_id.name"/><br/>
                  <span class="cr-number">CR: <t t-esc="employee.company_id.contract_cr_number or employee.company_id.vat or ''"/></span>
                </div>
              </td>
            </tr>
          </table>
        </div>

        <!-- Page Content -->
        <div class="page">
          <div class="contract-content">

            <!-- Title -->
            <p class="contract-title">
              Employment Contract (Open-Ended)<br/>
              <t t-esc="employee.company_id.name"/>
            </p>
            <p class="contract-subtitle">
              (Non-Bahraini Employment Contract)
            </p>

            <!-- Introduction -->
            <p class="introduction">
              This Employment Agreement ("Agreement") is made on the
              <strong><t t-esc="employee.contract_start_date.strftime('%d')"/>th day of <t t-esc="employee.contract_start_date.strftime('%B %Y')"/></strong>
              and entered into by and between:
            </p>

            <!-- Employer vs Employee Table -->
            <table class="party-table">
              <tbody>
                <tr>
                  <td><strong>Employer</strong></td>
                  <td><strong>Employee</strong></td>
                </tr>
                <tr>
                  <td>
                    <strong>Company:</strong><br/>
                    <span t-esc="employee.company_id.name"/>
                  </td>
                  <td>
                    <strong>Name:</strong><br/>
                    <span t-field="employee.name"/>
                  </td>
                </tr>
                <tr>
                  <td>
                    <strong>CR:</strong><br/>
                    <t t-esc="employee.company_id.contract_cr_number or employee.company_id.vat or ''"/>
                  </td>
                  <td>
                    <strong>Passport / CPR:</strong><br/>
                    <t t-if="employee.identification_id">
                      <span t-field="employee.identification_id"/>
                    </t>
                    <t t-else="">
                      <span t-field="employee.passport_id"/>
                    </t>
                  </td>
                </tr>
                <tr>
                  <td>
                    <strong>Address:</strong><br/>
                    <span t-esc="employee.company_id.contract_address or employee.company_id.partner_id.contact_address or ''"/>
                  </td>
                  <td>
                    <strong>Nationality:</strong><br/>
                    <span t-field="employee.country_id"/>
                  </td>
                </tr>
                <tr>
                  <td>
                    <strong>Represented By:</strong><br/>
                    <t t-esc="employee.company_id.contract_representative or ''"/>
                  </td>
                  <td>
                    <strong>Employee Address:</strong><br/>
                    <span t-esc="employee.address_id.contact_address or ''"/>
                  </td>
                </tr>
              </tbody>
            </table>

            <!-- Job Details -->
            <table class="job-table">
              <tbody>
                <tr>
                  <td><strong>Job Title</strong></td>
                  <td><t t-esc="employee.job_title or ''"/></td>
                </tr>
                <tr>
                  <td><strong>Start Date</strong></td>
                  <td><span t-field="employee.contract_start_date"/></td>
                </tr>
                <tr>
                  <td><strong>Contract Type</strong></td>
                  <td>Open-Ended</td>
                </tr>
              </tbody>
            </table>

            <!-- Dynamic Contract Clauses from Template -->
            <t t-foreach="employee.contract_template_id.rule_ids" t-as="rule">
              <p class="section-title">
                <t t-esc="rule.title"/>
              </p>
              <t t-if="rule.name == 'Salary'">
                <!-- Salary section with dynamic salary lines -->
                <table class="salary-table">
                  <tr>
                    <td>Monthly Salary</td>
                    <td></td>
                  </tr>
                  <t t-foreach="employee.salary_line_ids" t-as="line">
                    <tr>
                      <td><t t-esc="line.allowance_name"/></td>
                      <td><t t-esc="line.currency_id.symbol"/> <t t-esc="'%.2f' % line.amount"/></td>
                    </tr>
                  </t>
                  <tr class="salary-total">
                    <td>TOTAL</td>
                    <td><t t-esc="employee.salary_line_ids.currency_id.symbol or 'BHD'"/> <t t-esc="'%.2f' % sum(employee.salary_line_ids.mapped('amount'))"/></td>
                  </tr>
                </table>
              </t>
              <t t-else="">
                <!-- Regular HTML content for other sections -->
                <div t-field="rule.description"/>
              </t>
            </t>

            <!-- Signature Section -->
            <div class="signature-space"></div>
            <table class="signature-table">
              <tr>
                <td><strong>Employer</strong></td>
                <td><strong>Employee</strong></td>
              </tr>
              <tr>
                <td class="signature-cell">
                  <p>Name:</p>
                  <div class="signature-line"></div>
                  <p>Signature:</p>
                  <div class="signature-line"></div>
                  <p>Date:</p>
                  <div class="signature-line">
                    <span t-field="employee.contract_start_date"/>
                  </div>
                </td>
                <td class="signature-cell">
                  <p>I, <strong><span t-field="employee.name"/></strong>, agree to the terms of this Agreement.</p>
                  <p>Signature:</p>
                  <div class="signature-line"></div>
                  <p>Date:</p>
                  <div class="signature-line"></div>
                </td>
              </tr>
            </table>

          </div> <!-- end .contract-content -->
        </div> <!-- end .page -->

        <!-- Fixed Footer -->
        <div class="footer">
          <table class="footer-table">
            <tr>
              <td class="footer-left">
                <t t-if="employee.company_id.contract_footer_image">
                  <img t-att-src="'/web/image/%s/%s/contract_footer_image' % ('res.company', employee.company_id.id)" style="height: 40px;"/>
                </t>
                <t t-else="">
                  <span class="footer-company" t-esc="employee.company_id.name"/>
                  <span class="footer-phone" t-esc="employee.company_id.contract_phone or ''"/>
                </t>
              </td>
            </tr>
          </table>
        </div>

      </t>
    </t>
  </template>
</odoo>