<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Custom Paper Format for Contract Reports -->
    <record id="paperformat_contract_a4" model="report.paperformat">
      <field name="name">A4 Contract</field>
      <field name="default" eval="False"/>
      <field name="format">A4</field>
      <field name="orientation">Portrait</field>
      <field name="margin_top">100</field>
      <field name="margin_bottom">60</field>
      <field name="margin_left">45</field>
      <field name="margin_right">45</field>
      <field name="header_line" eval="False"/>
      <field name="header_spacing">100</field>
      <field name="dpi">100</field>
    </record>
  </data>
</odoo>
