<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Contract Management Menu -->
  <menuitem id="menu_contract_management" name="Contract Management"
            parent="hr.menu_hr_root" sequence="20"/>
  
  <menuitem id="menu_contract_rules" name="Contract Rules"
            parent="menu_contract_management" sequence="10"/>

  <!-- Action for Contract Rules -->
  <record id="action_contract_rules" model="ir.actions.act_window">
    <field name="name">Contract Rules</field>
    <field name="res_model">hr.contract.rule</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_contract_rules_action" name="Rules"
            parent="menu_contract_rules"
            action="action_contract_rules"/>

  <!-- List view for hr.contract.rule -->
  <record id="view_contract_rule_list" model="ir.ui.view">
    <field name="name">hr.contract.rule.list</field>
    <field name="model">hr.contract.rule</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="title"/>
        <field name="nationality_type"/>
        <field name="company_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <!-- Form view for hr.contract.rule -->
  <record id="view_contract_rule_form" model="ir.ui.view">
    <field name="name">hr.contract.rule.form</field>
    <field name="model">hr.contract.rule</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="active"/>
          </group>
          <group>
            <field name="title"/>
            <field name="nationality_type"/>
            <field name="company_id"/>
          </group>
        </group>
        <group string="Description">
          <field name="description" widget="html"/>
        </group>
      </form>
    </field>
  </record>

  <!-- Contract Templates Menu -->
  <menuitem id="menu_contract_templates" name="Contract Templates"
            parent="menu_contract_management" sequence="20"/>

  <!-- Action for Contract Templates -->
  <record id="action_contract_templates" model="ir.actions.act_window">
    <field name="name">Contract Templates</field>
    <field name="res_model">hr.contract.template</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_contract_templates_action" name="Templates"
            parent="menu_contract_templates"
            action="action_contract_templates"/>

  <!-- List view for hr.contract.template -->
  <record id="view_contract_template_list" model="ir.ui.view">
    <field name="name">hr.contract.template.list</field>
    <field name="model">hr.contract.template</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="nationality_type"/>
        <field name="company_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <!-- Form view for hr.contract.template -->
  <record id="view_contract_template_form" model="ir.ui.view">
    <field name="name">hr.contract.template.form</field>
    <field name="model">hr.contract.template</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="active"/>
          </group>
          <group>
            <field name="nationality_type"/>
            <field name="company_id"/>
          </group>
        </group>
        <group string="Contract Rules">
          <field name="rule_ids" widget="many2many_tags"/>
        </group>
      </form>
    </field>
  </record>

  <!-- Inherit hr.employee form to add contract template and salary lines -->
  <record id="view_employee_form_inherit" model="ir.ui.view">
    <field name="name">hr.employee.contract.form</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Contract Template" name="contract_template">
          <group>
            <field name="contract_template_id"/>
          </group>
        </page>
        <page string="Salary Lines" name="salary_lines">
          <group>
            <field name="salary_line_ids">
              <list editable="bottom">
                <field name="sequence"/>
                <field name="allowance_name"/>
                <field name="amount"/>
                <field name="currency_id"/>
              </list>
            </field>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <!-- Inherit res.company form to add contract settings -->
  <record id="view_company_form_inherit" model="ir.ui.view">
    <field name="name">res.company.contract.form</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Contract Settings" name="contract_settings">
          <group>
            <group string="Contact Information">
              <field name="contract_representative"/>
              <field name="contract_cr_number"/>
              <field name="contract_address"/>
              <field name="contract_phone"/>
              <field name="contract_email"/>
              <field name="contract_website"/>
            </group>
            <group string="Images">
              <field name="contract_header_image" widget="image"/>
              <field name="contract_footer_image" widget="image"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
