<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_category_final_gross" model="hr.salary.rule.category">
            <field name="name">Final Settlement - Total Earnings</field>
            <field name="code">FINALGROSS</field>
            <field name="country_id" eval="False"/>
        </record>

        <record id="rule_category_final_salary" model="hr.salary.rule.category">
            <field name="name">Final Month Salary</field>
            <field name="code">FINALSALARY</field>
            <field name="parent_id" ref="rule_category_final_gross"/>
            <field name="country_id" eval="False"/>
        </record>

        <record id="rule_category_final_leave" model="hr.salary.rule.category">
            <field name="name">Annual Leave Encashment</field>
            <field name="code">FINALLEAVE</field>
            <field name="parent_id" ref="rule_category_final_gross"/>
            <field name="country_id" eval="False"/>
        </record>

        <record id="rule_category_final_other_earn" model="hr.salary.rule.category">
            <field name="name">Final Settlement - Other Earnings</field>
            <field name="code">FINALOTHEREARN</field>
            <field name="parent_id" ref="rule_category_final_gross"/>
            <field name="country_id" eval="False"/>
        </record>

        <record id="rule_category_final_dedtotal" model="hr.salary.rule.category">
            <field name="name">Final Settlement - Total Deductions</field>
            <field name="code">FINALDEDTOTAL</field>
            <field name="country_id" eval="False"/>
        </record>

        <record id="rule_category_final_sio" model="hr.salary.rule.category">
            <field name="name">Social Insurance Organization Deduction</field>
            <field name="code">FINALSIO</field>
            <field name="parent_id" ref="rule_category_final_dedtotal"/>
            <field name="country_id" eval="False"/>
        </record>

        <record id="rule_category_final_other_ded" model="hr.salary.rule.category">
            <field name="name">Final Settlement - Other Deductions</field>
            <field name="code">FINALOTHERDED</field>
            <field name="parent_id" ref="rule_category_final_dedtotal"/>
            <field name="country_id" eval="False"/>
        </record>

        <record id="rule_category_final_net" model="hr.salary.rule.category">
            <field name="name">Final Settlement - Net</field>
            <field name="code">FINALNET</field>
            <field name="country_id" eval="False"/>
        </record>

    </data>
</odoo>
