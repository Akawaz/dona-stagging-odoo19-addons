<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_employee_form_inherit_final_settlement" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.final.settlement</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_final_settlements" type="object"
                            class="oe_stat_button" icon="fa-file-text-o"
                            invisible="not final_settlement_count">
                        <field name="final_settlement_count" widget="statinfo" string="Final Settlements"/>
                    </button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
