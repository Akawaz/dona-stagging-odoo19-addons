<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hr_payslip_form_inherit_final_settlement" model="ir.ui.view">
            <field name="name">hr.payslip.form.inherit.final.settlement</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_final_settlement" type="object"
                            class="oe_stat_button" icon="fa-file-text-o"
                            invisible="not final_settlement_ids">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Final Settlement</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
