<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_hr_final_settlement" model="ir.module.category">
            <field name="name">Final Settlement</field>
            <field name="sequence">15</field>
        </record>

        <record id="res_groups_privilege_hr_final_settlement" model="res.groups.privilege">
            <field name="name">Final Settlement</field>
            <field name="sequence">15</field>
            <field name="category_id" ref="module_category_hr_final_settlement"/>
        </record>

        <record id="group_hr_final_settlement_user" model="res.groups">
            <field name="name">User: Prepare Settlements</field>
            <field name="privilege_id" ref="res_groups_privilege_hr_final_settlement"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_hr_final_settlement_manager" model="res.groups">
            <field name="name">Manager: Approve, Override &amp; Finalize</field>
            <field name="privilege_id" ref="res_groups_privilege_hr_final_settlement"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_final_settlement_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="hr_final_settlement_comp_rule" model="ir.rule">
            <field name="name">Final Settlement: multi-company</field>
            <field name="model_id" ref="model_hr_final_settlement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_final_settlement_line_comp_rule" model="ir.rule">
            <field name="name">Final Settlement Line: multi-company</field>
            <field name="model_id" ref="model_hr_final_settlement_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
