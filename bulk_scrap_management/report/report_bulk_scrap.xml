<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_bulk_scrap">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Bulk Scrap Report</h2>
                        <div class="oe_structure"/>

                        <!-- Header Info -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <table class="table table-borderless">
                                    <tr>
                                        <td><strong>Scrap Number:</strong></td>
                                        <td><t t-out="o.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Created By:</strong></td>
                                        <td><t t-out="o.user_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Date &amp; Time:</strong></td>
                                        <td><t t-out="o.date"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Company:</strong></td>
                                        <td><t t-out="o.company_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-borderless">
                                    <tr>
                                        <td><strong>Source Location:</strong></td>
                                        <td><t t-out="o.location_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Destination Location:</strong></td>
                                        <td><t t-out="o.scrap_location_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Source Document:</strong></td>
                                        <td><t t-out="o.source_document or '-'"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Validated By:</strong></td>
                                        <td><t t-out="o.reviewer_id.name or '-'"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div t-if="o.notes" class="mt-3">
                            <strong>Notes:</strong>
                            <p><t t-out="o.notes"/></p>
                        </div>

                        <!-- Products Table -->
                        <h4 class="mt-4">Scrapped Products</h4>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th class="text-center">#</th>
                                    <th>Product</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-right">Unit Cost</th>
                                    <th class="text-right">Total Cost</th>
                                    <th>Reason</th>
                                    <th class="text-center">Replenish</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center"><t t-out="line_index + 1"/></td>
                                        <td><t t-out="line.product_id.display_name"/></td>
                                        <td class="text-center">
                                            <t t-out="line.quantity"/>
                                            <t t-out="line.product_uom_id.name"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-out="line.product_id.standard_price" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-out="line.cost" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                        </td>
                                        <td><t t-out="line.reason or '-'"/></td>
                                        <td class="text-center">
                                            <t t-if="line.replenish_qty">Yes</t>
                                            <t t-else="">No</t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-right"><strong>Total Cost:</strong></td>
                                    <td class="text-right">
                                        <strong>
                                            <t t-out="o.total_cost" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                        </strong>
                                    </td>
                                    <td colspan="2"/>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Footer -->
                        <div class="mt-5">
                            <div class="row">
                                <div class="col-6 text-center">
                                    <hr/>
                                    <p><strong>Created By</strong></p>
                                    <p><t t-out="o.user_id.name"/></p>
                                </div>
                                <div class="col-6 text-center">
                                    <hr/>
                                    <p><strong>Validated By</strong></p>
                                    <p><t t-out="o.reviewer_id.name or '-'"/></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
